# The LoRA fine-tune of CHURRO-3B as a CHTC GPU job. Edit NETID, then
#     condor_submit finetune.sub
# Every setting the script takes can be changed on the arguments line without
# touching the script, the same flags the lesson's SageMaker job used.

NETID = bbadger
STAGING = osdf:///chtc/staging/$SUBSTR(NETID,0,1)/$(NETID)

# --- what runs: the container, the wrapper script, and the script's flags ---
container_image = $(STAGING)/churro.sif
executable = finetune.sh
arguments = --epochs 2 --lr 2e-4 --lora_r 16 --batch_size 1 --grad_accum 4 --eval_pages 15 --eval_before 1 --curve_pages 8

# --- what goes in: the two Python files, the data (small, from /home) and the model (large, from /staging) ---
transfer_input_files = finetune_churro_lora.py, badger_scribe_helpers.py, badger-scribe-data.tar.gz, $(STAGING)/churro-3B.tar

# --- what comes back to the submit directory in /home: the adapter and the scores, about 100 MB ---
transfer_output_files = adapter.tar.gz, output/data

log = finetune_$(Cluster).log
output = finetune_$(Cluster).out
error = finetune_$(Cluster).err

# --- the machine: one GPU with at least 20 GB of memory and bf16 support (capability 8.0 is Ampere and newer) ---
request_gpus = 1
+WantGPULab = true
# under 12 hours; this job is about 20 minutes
+GPUJobLength = "short"
# also run on backfill GPUs, the cards other groups own and are not using; the job may be interrupted there
+is_resumable = true
# MB; the memory rule says a 3B LoRA needs about 12 GB, with room for the before/after scoring
gpus_minimum_memory = 20000
# bf16, which the script trains in by default
gpus_minimum_capability = 8.0

# --- checkpoints: finetune.sh stops with exit code 85 after two hours, HTCondor keeps output/ckpt and requeues the job, and
# --- the script resumes from the last epoch's checkpoint. The same thing happens when a backfill job is interrupted.
checkpoint_exit_code = 85
transfer_checkpoint_files = output/ckpt

request_cpus = 4
# peak is loading the 7.5 GB model into CPU memory before it moves to the GPU
request_memory = 32GB
# the 7.5 GB tar plus its unpacked copy, the data, the container's working files and the outputs
request_disk = 40GB

queue
